{
  "name": "agent-harness-orchestrator",
  "version": "0.1.0",
  "description": "Local-first Spec-Anchored managed-run harness for AI coding.",
  "type": "module",
  "bin": {
    "aho": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && vite build && node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "test": "npm run test:fast && npm run test:integration && npm run test:workbench",
    "test:fast": "vitest run --exclude tests/unit/workbench.test.ts --exclude tests/unit/workbench-demand-worker.test.ts --exclude tests/slow/** --exclude tests/integration/cli-flow.test.ts",
    "test:workbench": "vitest run tests/unit/workbench.test.ts && vitest run tests/unit/workbench-demand-worker.test.ts && npm run test:workbench:slow",
    "test:workbench:slow": "vitest run tests/slow/workbench-scheduler-flow.test.ts && vitest run tests/slow/workbench-remote-landing-flow.test.ts && vitest run tests/slow/workbench-apply-integration-flow.test.ts && vitest run tests/slow/workbench-goal-loop-prompt-flow.test.ts",
    "test:integration": "vitest run tests/integration/cli-flow.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
