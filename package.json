{
  "name": "agent-harness-orchestrator",
  "version": "0.1.0",
  "description": "Local-first, change-driven AI coding orchestrator with repo-local Harness and controlled evolution.",
  "type": "module",
  "bin": {
    "aho": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^2.1.9"
  }
}
